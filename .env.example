# Supabase project settings (Project Settings -> API)
# The anon/publishable key is safe to expose to the browser when RLS is enabled.
# Replace the placeholder below with the real value from Supabase -> Project
# Settings -> API -> "anon / publishable" key. A value left as the placeholder
# is treated as missing and the app stays in demo mode.
VITE_SUPABASE_URL="https://qwaehqsmodekbgvnaavz.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Vite inlines every VITE_* variable into the JavaScript bundle at BUILD time.
# Locally:  copy this file to .env in the project root, then restart `npm run dev`.
# On Vercel: add them under Project Settings -> Environment Variables for
#            Production (and Preview/Development as needed), then REDEPLOY.
#            Editing a variable never updates an already-built deployment.
# Never put the Supabase service_role / secret key in a VITE_* variable.

# Universal Nexora auth storage key for the PKCE session. Namespacing it keeps
# this app's tokens separate from any other Nexora app served on the same origin.
# Defaults to nexora.auth.<project-ref> when omitted.
VITE_SUPABASE_STORAGE_KEY="nexora.auth.qwaehqsmodekbgvnaavz"

# Express/Docker hosts (server.ts, `npm start`) additionally accept the plain
# server-side names below from the SERVER environment and inject them into the
# served page at runtime — no rebuild needed when they change. The browser
# always prefers build-time VITE_* values when those are usable.
# SUPABASE_URL="https://qwaehqsmodekbgvnaavz.supabase.co"
# SUPABASE_ANON_KEY="your-publishable-key-when-running-behind-the-express-server"

# Optional AI feature key. Never place Supabase service_role keys in VITE_* vars.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL used for OAuth and password recovery redirects.
APP_URL="http://localhost:3000"
